      <mass value="0.03"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.000003" ixy="0.0" ixz="0.0" iyy="0.000003" iyz="0.0" izz="0.000003"/>
    </inertial>
    <!-- Upper mounting flange (flush against the underside of the wooden base plate) -->
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.0115"/>
      <geometry>
        <box size="0.042 0.028 0.002"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <!-- Front vertical clamp arm -->
    <visual>
      <origin rpy="0 0 0" xyz="0.013000000000000001 0 0"/>
      <geometry>
        <box size="0.002 0.024 0.023"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <!-- Rear vertical clamp arm -->
    <visual>
      <origin rpy="0 0 0" xyz="-0.013000000000000001 0 0"/>
      <geometry>
        <box size="0.002 0.024 0.023"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <!-- Bottom saddle strap wrapping under motor can -->
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.013000000000000001"/>
      <geometry>
        <box size="0.028 0.024 0.002"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <!-- Front fixing bolt securing clamp to base plate -->
    <visual>
      <origin rpy="0 0 0" xyz="0.016 0 0.0125"/>
      <geometry>
        <cylinder length="0.004" radius="0.002"/>
      </geometry>
      <material name="metal"/>
    </visual>
    <!-- Rear fixing bolt securing clamp to base plate -->
    <visual>
      <origin rpy="0 0 0" xyz="-0.016 0 0.0125"/>
      <geometry>
        <cylinder length="0.004" radius="0.002"/>
      </geometry>
      <material name="metal"/>
    </visual>
    <!-- Gearbox face bracket flange -->
    <visual>
      <origin rpy="0 0 0" xyz="0 -0.021 0"/>
      <geometry>
        <box size="0.027 0.002 0.027"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.042 0.028 0.027"/>
      </geometry>
    </collision>
  </link>
  <joint name="right_motor_clamp_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_motor_clamp"/>
    <origin rpy="0 0 0" xyz="-0.07 -0.084 -0.02"/>
  </joint>
  <gazebo reference="left_motor_clamp">
    <material>Gazebo/DarkGrey</material>
  </gazebo>
  <gazebo reference="right_motor_clamp">
    <material>Gazebo/DarkGrey</material>
  </gazebo>
  <!-- ================================================================ -->
  <!-- LEFT WHEEL                                                        -->
  <!-- Cylinder axis along Y -> rpy="${pi/2} 0 0"                       -->
  <!-- ================================================================ -->
  <link name="left_wheel">
    <inertial>
      <mass value="0.3"/>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 0"/>
      <inertia ixx="0.00023" ixy="0.0" ixz="0.0" iyy="0.00023" iyz="0.0" izz="0.00038"/>
    </inertial>
    <visual>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.03" radius="0.0335"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.03" radius="0.0335"/>
      </geometry>
    </collision>
  </link>
  <joint name="joint_left_wheel" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <!-- base_link is at height chassis_z, wheel centre is at motor_z -->
    <origin rpy="0 0 0" xyz="-0.07 0.155 -0.02"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>
  <gazebo reference="left_wheel">
    <material>Gazebo/Blue</material>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
    <kp>1e5</kp>
    <kd>100.0</kd>
  </gazebo>
  <!-- ================================================================ -->
  <!-- RIGHT WHEEL                                                       -->
  <!-- ================================================================ -->
  <link name="right_wheel">
    <inertial>
      <mass value="0.3"/>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 0"/>
      <inertia ixx="0.00023" ixy="0.0" ixz="0.0" iyy="0.00023" iyz="0.0" izz="0.00038"/>
    </inertial>
    <visual>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.03" radius="0.0335"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.03" radius="0.0335"/>
      </geometry>
    </collision>
  </link>
  <joint name="joint_right_wheel" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <!-- base_link is at height chassis_z, wheel centre is at motor_z -->
    <origin rpy="0 0 0" xyz="-0.07 -0.155 -0.02"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>
  <gazebo reference="right_wheel">
    <material>Gazebo/Blue</material>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
    <kp>1e5</kp>
    <kd>100.0</kd>
  </gazebo>
  <!-- ================================================================ -->
  <!-- CASTER WHEEL  (ball caster mounted under plate, zero friction)    -->
  <!-- ================================================================ -->
  <link name="caster">
    <inertial>
      <mass value="0.1"/>
      <origin rpy="0 0 0" xyz="0 0 -0.036750000000000005"/>
      <inertia ixx="0.00002" ixy="0.0" ixz="0.0" iyy="0.00002" iyz="0.0" izz="0.00002"/>
    </inertial>
    <!-- Top mounting plate bolted under the wooden base plate -->
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.009"/>
      <geometry>
        <box size="0.038 0.034 0.003"/>
      </geometry>
      <material name="metal"/>
    </visual>
    <!-- Caster body / cup housing extending down towards the ball -->
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.024"/>
      <geometry>
        <cylinder length="0.026" radius="0.015"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <!-- Ball caster sphere rolling on the ground -->
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.036750000000000005"/>
      <geometry>
        <sphere radius="0.01675"/>
      </geometry>
      <material name="metal"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 -0.036750000000000005"/>
      <geometry>
        <sphere radius="0.01675"/>
      </geometry>
    </collision>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster"/>
    <!-- Positioned at front of base plate (x = 0.13), joint origin at x=0.13, y=0, z=0 -->
    <origin rpy="0 0 0" xyz="0.13 0 0"/>
  </joint>
  <gazebo reference="caster">
    <material>Gazebo/Grey</material>
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <kp>1e5</kp>
    <kd>100.0</kd>
  </gazebo>
  <!-- ================================================================ -->
  <!-- IMU  (MPU-6050 resting and fixed on top of the base plate)       -->
  <!-- ================================================================ -->
  <link name="imu_link">
    <inertial>
      <mass value="0.02"/>
      <origin rpy="0 0 0" xyz="0 0 0.001"/>
      <inertia ixx="0.000002" ixy="0.0" ixz="0.0" iyy="0.000002" iyz="0.0" izz="0.000003"/>
    </inertial>
    <!-- MPU-6050 module: purple PCB ~20 × 16 mm resting flat on plate top -->
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.0008"/>
      <geometry>
        <box size="0.020 0.016 0.0016"/>
      </geometry>
      <material name="pcb_purple"/>
    </visual>
    <!-- MPU-6050 IC chip (QFN package, centred on PCB) -->
    <visual>
      <origin rpy="0 0 0" xyz="0.001 0 0.0022"/>
      <geometry>
        <box size="0.005 0.005 0.0012"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <!-- Header pin row (one long edge) -->
    <visual>
      <origin rpy="0 0 0" xyz="-0.008 0 0.0035"/>
      <geometry>
        <box size="0.0025 0.016 0.005"/>
      </geometry>
      <material name="metal"/>
    </visual>
    <!-- Mounting screw 1 fixing IMU to base plate -->
    <visual>
      <origin rpy="0 0 0" xyz="0.007 0.0055 0.0018"/>
      <geometry>
        <cylinder length="0.002" radius="0.0016"/>
      </geometry>
      <material name="metal"/>
    </visual>
    <!-- Mounting screw 2 fixing IMU to base plate -->
    <visual>
      <origin rpy="0 0 0" xyz="0.007 -0.0055 0.0018"/>
      <geometry>
        <cylinder length="0.002" radius="0.0016"/>
      </geometry>
      <material name="metal"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.002"/>
      <geometry>
        <box size="0.020 0.016 0.004"/>
      </geometry>
    </collision>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <!-- Place IMU on top surface of base_link plate -->
    <origin rpy="0 0 0" xyz="0 0 0.0075"/>
  </joint>
  <gazebo reference="imu_link">
    <material>Gazebo/Black</material>
  </gazebo>
  <!-- ================================================================ -->
  <!-- LIDAR                                                             -->
  <!-- ================================================================ -->
  <link name="laser">
    <inertial>
      <mass value="0.15"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.00005" ixy="0.0" ixz="0.0" iyy="0.00005" iyz="0.0" izz="0.00008"/>
    </inertial>
    <!-- RPLiDAR A1 — main body (~76 mm dia × 30 mm) -->
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.007"/>
      <geometry>
        <cylinder length="0.030" radius="0.038"/>
      </geometry>
      <material name="black"/>
    </visual>
    <!-- RPLiDAR A1 — rotating scanner head (slightly narrower, dark grey) -->
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.014"/>
      <geometry>
        <cylinder length="0.020" radius="0.028"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <!-- RPLiDAR A1 — USB/motor connector stub -->
    <visual>
      <origin rpy="0 1.5707963267948966 0" xyz="0.042 0 -0.007"/>
      <geometry>
        <cylinder length="0.010" radius="0.005"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.004"/>
      <geometry>
        <cylinder length="0.050" radius="0.038"/>
      </geometry>
    </collision>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="top_layer"/>
    <child link="laser"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.025"/>
  </joint>
  <!-- ================================================================ -->
  <!-- LIDAR SENSOR — Ignition Gazebo 6 (Fortress) gpu_lidar           -->
  <!-- Bridged to /scan via ros_gz_bridge in sim.launch.py             -->
  <!-- ================================================================ -->
  <gazebo reference="laser">
    <material>Gazebo/Black</material>
    <sensor name="lidar" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
      <!-- Ignition Fortress: sensor systems loaded via the model-level plugin below -->
      <!-- Topic is automatically: /world/empty/model/wobble/link/laser/sensor/lidar/scan -->
      <!-- Bridged to /scan in sim.launch.py -->
    </sensor>
  </gazebo>
  <!-- ================================================================ -->
  <!-- IGNITION GAZEBO 6 (FORTRESS) MODEL PLUGINS                       -->
  <!-- ================================================================ -->
  <gazebo>
    <!-- Differential Drive (Ignition native — no ROS wrapper needed) -->
    <!-- ros_gz_bridge in sim.launch.py bridges /cmd_vel and /odom    -->
    <plugin filename="libignition-gazebo6-diff-drive-system.so" name="ignition::gazebo::systems::DiffDrive">
      <left_joint>joint_left_wheel</left_joint>
      <right_joint>joint_right_wheel</right_joint>
      <wheel_separation>0.31</wheel_separation>
      <wheel_radius>0.0335</wheel_radius>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_linear_acceleration>-1.0</min_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
      <min_angular_acceleration>-2.0</min_angular_acceleration>
      <!-- Ignition topic names (bridged to ROS2 by ros_gz_bridge) -->
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
    <!-- Joint State Publisher (Ignition native -> bridged to /joint_states) -->
    <!-- Required so robot_state_publisher broadcasts continuous wheel TFs     -->
    <plugin filename="libignition-gazebo6-joint-state-publisher-system.so" name="ignition::gazebo::systems::JointStatePublisher">
      <topic>/joint_states</topic>
      <joint_name>joint_left_wheel</joint_name>
      <joint_name>joint_right_wheel</joint_name>
    </plugin>
  </gazebo>
</robot>
