<?xml version="1.0"?>
<robot name="wobble">

  <!-- ================= MATERIALS ================= -->
  <material name="wood"><color rgba="0.55 0.35 0.20 1"/></material>
  <material name="steel"><color rgba="0.75 0.75 0.75 1"/></material>
  <material name="blue"><color rgba="0.1 0.3 0.9 1"/></material>
  <material name="grey"><color rgba="0.6 0.6 0.6 1"/></material>
  <material name="black"><color rgba="0.05 0.05 0.05 1"/></material>

  <!-- ================= BASE ================= -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.31 0.23 0.012"/>
      </geometry>
      <material name="wood"/>
    </visual>

    <collision>
      <geometry>
        <box size="0.31 0.23 0.012"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="3.0"/>
      <inertia ixx="0.014" ixy="0" ixz="0"
               iyy="0.020" iyz="0"
               izz="0.034"/>
    </inertial>
  </link>

  <!-- ================= SECOND LAYER ================= -->
  <link name="second_layer">
    <visual>
      <geometry>
        <box size="0.26 0.17 0.012"/>
      </geometry>
      <material name="wood"/>
    </visual>
  </link>

  <joint name="base_to_second" type="fixed">
    <parent link="base_link"/>
    <child link="second_layer"/>
    <origin xyz="0 0 0.15"/>
  </joint>

  <!-- ================= THIRD LAYER ================= -->
  <link name="third_layer">
    <visual>
      <geometry>
        <box size="0.20 0.11 0.012"/>
      </geometry>
      <material name="wood"/>
    </visual>
  </link>

  <joint name="second_to_third" type="fixed">
    <parent link="second_layer"/>
    <child link="third_layer"/>
    <origin xyz="0 0 0.11"/>
  </joint>

  <!-- ================= SUPPORT RODS ================= -->

  <link name="rod_1">
    <visual>
      <geometry>
        <cylinder radius="0.0035" length="0.15"/>
      </geometry>
      <material name="steel"/>
    </visual>
  </link>

  <joint name="rod_1_j" type="fixed">
    <parent link="base_link"/>
    <child link="rod_1"/>
    <origin xyz="0.12 0.08 0.075"/>
  </joint>

  <link name="rod_2">
    <visual>
      <geometry>
        <cylinder radius="0.0035" length="0.15"/>
      </geometry>
      <material name="steel"/>
    </visual>
  </link>

  <joint name="rod_2_j" type="fixed">
    <parent link="base_link"/>
    <child link="rod_2"/>
    <origin xyz="0.12 -0.08 0.075"/>
  </joint>

  <link name="rod_3">
    <visual>
      <geometry>
        <cylinder radius="0.0035" length="0.15"/>
      </geometry>
      <material name="steel"/>
    </visual>
  </link>

  <joint name="rod_3_j" type="fixed">
    <parent link="base_link"/>
    <child link="rod_3"/>
    <origin xyz="-0.12 0.08 0.075"/>
  </joint>

  <link name="rod_4">
    <visual>
      <geometry>
        <cylinder radius="0.0035" length="0.15"/>
      </geometry>
      <material name="steel"/>
    </visual>
  </link>

  <joint name="rod_4_j" type="fixed">
    <parent link="base_link"/>
    <child link="rod_4"/>
    <origin xyz="-0.12 -0.08 0.075"/>
  </joint>

  <link name="rod_5">
    <visual>
      <geometry>
        <cylinder radius="0.0035" length="0.11"/>
      </geometry>
      <material name="steel"/>
    </visual>
  </link>

  <joint name="rod_5_j" type="fixed">
    <parent link="second_layer"/>
    <child link="rod_5"/>
    <origin xyz="0.08 0 0.055"/>
  </joint>

  <link name="rod_6">
    <visual>
      <geometry>
        <cylinder radius="0.0035" length="0.11"/>
      </geometry>
      <material name="steel"/>
    </visual>
  </link>

  <joint name="rod_6_j" type="fixed">
    <parent link="second_layer"/>
    <child link="rod_6"/>
    <origin xyz="-0.08 0 0.055"/>
  </joint>

  <!-- ================= LEFT MOTOR ================= -->

  <link name="left_motor">
    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.01" length="0.06"/>
      </geometry>
      <material name="steel"/>
    </visual>
  </link>

  <joint name="left_motor_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_motor"/>
    <origin xyz="-0.135 0.09 -0.016"/>
  </joint>

  <link name="left_shaft">
    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.004" length="0.015"/>
      </geometry>
      <material name="steel"/>
    </visual>
  </link>

  <joint name="left_shaft_joint" type="fixed">
    <parent link="left_motor"/>
    <child link="left_shaft"/>
    <origin xyz="0 0.0375 0"/>
  </joint>

  <link name="left_wheel">
    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.03"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.03"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.00012" ixy="0" ixz="0"
               iyy="0.00006" iyz="0"
               izz="0.00012"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="left_shaft"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.0225 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ================= RIGHT MOTOR ================= -->

  <link name="right_motor">
    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.01" length="0.06"/>
      </geometry>
      <material name="steel"/>
    </visual>
  </link>

  <joint name="right_motor_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_motor"/>
    <origin xyz="-0.135 -0.09 -0.016"/>
  </joint>

  <link name="right_shaft">
    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.004" length="0.015"/>
      </geometry>
      <material name="steel"/>
    </visual>
  </link>

  <joint name="right_shaft_joint" type="fixed">
    <parent link="right_motor"/>
    <child link="right_shaft"/>
    <origin xyz="0 -0.0375 0"/>
  </joint>

  <link name="right_wheel">
    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.03"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.03"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.00012" ixy="0" ixz="0"
               iyy="0.00006" iyz="0"
               izz="0.00012"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="right_shaft"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.0225 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ================= CASTER ================= -->

  <link name="caster_wheel">

    <visual>
      <geometry>
        <sphere radius="0.02"/>
      </geometry>
      <material name="grey"/>
    </visual>

    <collision>
      <geometry>
        <sphere radius="0.02"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0"
               iyy="0.0001" iyz="0"
               izz="0.0001"/>
    </inertial>

  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel"/>
    <origin xyz="0.14 0 -0.026"/>
  </joint>

  <!-- ================= IMU ================= -->

  <link name="imu_link">
    <visual>
      <geometry>
        <box size="0.04 0.04 0.01"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.02"/>
  </joint>

  <!-- ================= LIDAR ================= -->
<link name="laser">

  <visual>
    <origin xyz="0 0 0"/>
    <geometry>
      <cylinder radius="0.035" length="0.025"/>
    </geometry>
    <material name="black"/>
  </visual>

</link>

<joint name="laser_joint" type="fixed">

  <parent link="base_link"/>

  <child link="laser"/>

  <origin xyz="0 0 0.279"/>

</joint>
  <!-- ================= DIFF DRIVE ================= -->

  <gazebo>

    <plugin filename="libgz-sim-diff-drive-system.so"
            name="gz::sim::systems::DiffDrive">

      <left_joint>left_wheel_joint</left_joint>

      <right_joint>right_wheel_joint</right_joint>

      <wheel_separation>0.18</wheel_separation>

      <wheel_radius>0.04</wheel_radius>

      <base_link>base_link</base_link>

      <odom_frame>odom</odom_frame>

      <publish_odom>true</publish_odom>

      <publish_odom_tf>true</publish_odom_tf>

      <update_rate>50</update_rate>

    </plugin>

  </gazebo>

</robot>
