<?xml version="1.0"?>
<robot name="wobble" xmlns:xacro="http://www.ros.org/wiki/xacro">

<!-- PARAMETERS -->

<xacro:property name="plate_length" value="0.32"/>
<xacro:property name="plate_width"  value="0.26"/>
<xacro:property name="plate_thickness" value="0.015"/>

<xacro:property name="layer_gap" value="0.12"/>

<xacro:property name="rod_radius" value="0.005"/>

<xacro:property name="wheel_radius" value="0.0335"/>
<xacro:property name="wheel_width" value="0.03"/>

<xacro:property name="wheel_x" value="-0.07"/>
<xacro:property name="wheel_y" value="0.155"/>

<xacro:property name="laser_x" value="0.0"/>
<xacro:property name="laser_y" value="0.0"/>
<xacro:property name="laser_z" value="${wheel_radius + 2*layer_gap + 0.015}"/>
<xacro:property name="laser_roll" value="0.0"/>
<xacro:property name="laser_pitch" value="0.0"/>
<xacro:property name="laser_yaw" value="0.0"/>


<!-- MATERIALS -->

<material name="wood">
<color rgba="0.65 0.32 0.12 1"/>
</material>

<material name="metal">
<color rgba="0.75 0.75 0.75 1"/>
</material>

<material name="blue">
<color rgba="0.05 0.05 0.8 1"/>
</material>

<material name="black">
<color rgba="0.1 0.1 0.1 1"/>
</material>


<!-- BASE LAYER -->

<link name="base_link">

<inertial>
<mass value="2.0"/>
<origin xyz="0 0 ${wheel_radius}"/>
<inertia ixx="0.0416" ixy="0.0" ixz="0.0" iyy="0.0505" iyz="0.0" izz="0.0814"/>
</inertial>

<visual>
<origin xyz="0 0 ${wheel_radius}"/>
<geometry>
<box size="${plate_length} ${plate_width} ${plate_thickness}"/>
</geometry>
<material name="wood"/>
</visual>

<collision>
<origin xyz="0 0 ${wheel_radius}"/>
<geometry>
<box size="${plate_length} ${plate_width} ${plate_thickness}"/>
</geometry>
</collision>

</link>



<!-- SECOND LAYER -->

<link name="second_layer">

<inertial>
<mass value="1.0"/>
<origin xyz="0 0 ${wheel_radius + layer_gap}"/>
<inertia ixx="0.0208" ixy="0.0" ixz="0.0" iyy="0.0253" iyz="0.0" izz="0.0407"/>
</inertial>

<visual>
<origin xyz="0 0 ${wheel_radius + layer_gap}"/>
<geometry>
<box size="${plate_length} ${plate_width} ${plate_thickness}"/>
</geometry>
<material name="wood"/>
</visual>

<collision>
<origin xyz="0 0 ${wheel_radius + layer_gap}"/>
<geometry>
<box size="${plate_length} ${plate_width} ${plate_thickness}"/>
</geometry>
</collision>

</link>

<joint name="joint_second_layer" type="fixed">
<parent link="base_link"/>
<child link="second_layer"/>
</joint>



<!-- THIRD LAYER -->

<link name="top_layer">

<inertial>
<mass value="0.8"/>
<origin xyz="0 0 ${wheel_radius + 2*layer_gap}"/>
<inertia ixx="0.012" ixy="0.0" ixz="0.0" iyy="0.0149" iyz="0.0" izz="0.0235"/>
</inertial>

<visual>
<origin xyz="0 0 ${wheel_radius + 2*layer_gap}"/>
<geometry>
<box size="0.22 0.18 ${plate_thickness}"/>
</geometry>
<material name="wood"/>
</visual>

<collision>
<origin xyz="0 0 ${wheel_radius + 2*layer_gap}"/>
<geometry>
<box size="0.22 0.18 ${plate_thickness}"/>
</geometry>
</collision>

</link>

<joint name="joint_top_layer" type="fixed">
<parent link="second_layer"/>
<child link="top_layer"/>
</joint>



<!-- RODS -->

<xacro:macro name="rod" params="x y z length name">

<link name="${name}">
<inertial>
<mass value="0.1"/>
<origin xyz="${x} ${y} ${z}"/>
<inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
</inertial>
<visual>
<origin xyz="${x} ${y} ${z}"/>
<geometry>
<cylinder radius="${rod_radius}" length="${length}"/>
</geometry>
<material name="metal"/>
</visual>
<collision>
<origin xyz="${x} ${y} ${z}"/>
<geometry>
<cylinder radius="${rod_radius}" length="${length}"/>
</geometry>
</collision>
</link>

<joint name="joint_${name}" type="fixed">
<parent link="base_link"/>
<child link="${name}"/>
</joint>

</xacro:macro>


<xacro:rod x="0.12" y="0.09" z="${wheel_radius + layer_gap/2}" length="${layer_gap}" name="rod1"/>
<xacro:rod x="-0.12" y="0.09" z="${wheel_radius + layer_gap/2}" length="${layer_gap}" name="rod2"/>
<xacro:rod x="0.12" y="-0.09" z="${wheel_radius + layer_gap/2}" length="${layer_gap}" name="rod3"/>
<xacro:rod x="-0.12" y="-0.09" z="${wheel_radius + layer_gap/2}" length="${layer_gap}" name="rod4"/>

<xacro:rod x="0.09" y="0.06" z="${wheel_radius + 1.5*layer_gap}" length="${layer_gap}" name="rod5"/>
<xacro:rod x="-0.09" y="0.06" z="${wheel_radius + 1.5*layer_gap}" length="${layer_gap}" name="rod6"/>
<xacro:rod x="0.09" y="-0.06" z="${wheel_radius + 1.5*layer_gap}" length="${layer_gap}" name="rod7"/>
<xacro:rod x="-0.09" y="-0.06" z="${wheel_radius + 1.5*layer_gap}" length="${layer_gap}" name="rod8"/>



<!-- LEFT WHEEL -->

<link name="left_wheel">

<inertial>
<mass value="0.3"/>
<origin rpy="1.5708 0 0"/>
<inertia ixx="0.00023" ixy="0.0" ixz="0.0" iyy="0.00023" iyz="0.0" izz="0.00038"/>
</inertial>

<visual>
<origin rpy="1.5708 0 0"/>
<geometry>
<cylinder radius="${wheel_radius}" length="${wheel_width}"/>
</geometry>
<material name="blue"/>
</visual>

<collision>
<origin rpy="1.5708 0 0"/>
<geometry>
<cylinder radius="${wheel_radius}" length="${wheel_width}"/>
</geometry>
</collision>

</link>


<joint name="joint_left_wheel" type="continuous">

<parent link="base_link"/>
<child link="left_wheel"/>

<origin xyz="${wheel_x} ${wheel_y} ${wheel_radius}"/>

<axis xyz="0 1 0"/>

</joint>



<!-- RIGHT WHEEL -->

<link name="right_wheel">

<inertial>
<mass value="0.3"/>
<origin rpy="1.5708 0 0"/>
<inertia ixx="0.00023" ixy="0.0" ixz="0.0" iyy="0.00023" iyz="0.0" izz="0.00038"/>
</inertial>

<visual>
<origin rpy="1.5708 0 0"/>
<geometry>
<cylinder radius="${wheel_radius}" length="${wheel_width}"/>
</geometry>
<material name="blue"/>
</visual>

<collision>
<origin rpy="1.5708 0 0"/>
<geometry>
<cylinder radius="${wheel_radius}" length="${wheel_width}"/>
</geometry>
</collision>

</link>


<joint name="joint_right_wheel" type="continuous">

<parent link="base_link"/>
<child link="right_wheel"/>

<origin xyz="${wheel_x} -${wheel_y} ${wheel_radius}"/>

<axis xyz="0 1 0"/>

</joint>



<!-- CASTER -->

<link name="caster">

<inertial>
<mass value="0.1"/>
<origin xyz="0.13 0 ${wheel_radius/2}"/>
<inertia ixx="0.000042" ixy="0.0" ixz="0.0" iyy="0.000042" iyz="0.0" izz="0.000042"/>
</inertial>

<visual>
<geometry>
<sphere radius="${wheel_radius/2}"/>
</geometry>
<material name="metal"/>
</visual>

<collision>
<geometry>
<sphere radius="${wheel_radius/2}"/>
</geometry>
</collision>

</link>


<joint name="caster_joint" type="fixed">

<parent link="base_link"/>
<child link="caster"/>

<origin xyz="0.13 0 ${wheel_radius/2}"/>

</joint>



<!-- IMU -->

<link name="imu_link">

<inertial>
<mass value="0.05"/>
<origin xyz="0 0 ${plate_thickness/2}"/>
<inertia ixx="0.00002" ixy="0.0" ixz="0.0" iyy="0.00002" iyz="0.0" izz="0.00003"/>
</inertial>

<visual>
<origin xyz="0 0 ${plate_thickness/2}"/>
<geometry>
<box size="0.04 0.04 0.01"/>
</geometry>
<material name="black"/>
</visual>

<collision>
<origin xyz="0 0 ${plate_thickness/2}"/>
<geometry>
<box size="0.04 0.04 0.01"/>
</geometry>
</collision>

</link>


<joint name="imu_joint" type="fixed">

<parent link="base_link"/>
<child link="imu_link"/>

<origin xyz="0 0 ${wheel_radius}"/>

</joint>



<!-- LIDAR -->

<link name="laser">

<inertial>
<mass value="0.15"/>
<origin xyz="0 0 0"/>
<inertia ixx="0.00005" ixy="0.0" ixz="0.0" iyy="0.00005" iyz="0.0" izz="0.00008"/>
</inertial>

<visual>
<geometry>
<cylinder radius="0.035" length="0.03"/>
</geometry>
<material name="black"/>
</visual>

<collision>
<geometry>
<cylinder radius="0.035" length="0.03"/>
</geometry>
</collision>

</link>


<joint name="laser_joint" type="fixed">

<parent link="top_layer"/>
<child link="laser"/>

<origin
  xyz="${laser_x} ${laser_y} ${laser_z}"
  rpy="${laser_roll} ${laser_pitch} ${laser_yaw}"
/>

</joint>



<!-- DIFF DRIVE -->

<gazebo reference="left_wheel">
<friction>
<ode>
<mu1>0.8</mu1>
<mu2>0.8</mu2>
</ode>
</friction>
</gazebo>

<gazebo reference="right_wheel">
<friction>
<ode>
<mu1>0.8</mu1>
<mu2>0.8</mu2>
</ode>
</friction>
</gazebo>


</robot>
