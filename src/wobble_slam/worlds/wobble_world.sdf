<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="wobble_world">

    <!-- ================================================================ -->
    <!-- PHYSICS                                                           -->
    <!-- ================================================================ -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- ================================================================ -->
    <!-- IGNITION GAZEBO SYSTEM PLUGINS                                   -->
    <!-- ================================================================ -->
    <plugin
      filename="libignition-gazebo6-physics-system.so"
      name="ignition::gazebo::systems::Physics">
    </plugin>
    <plugin
      filename="libignition-gazebo6-user-commands-system.so"
      name="ignition::gazebo::systems::UserCommands">
    </plugin>
    <plugin
      filename="libignition-gazebo6-scene-broadcaster-system.so"
      name="ignition::gazebo::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="libignition-gazebo6-sensors-system.so"
      name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- ================================================================ -->
    <!-- LIGHTING & AMBIENT                                                -->
    <!-- ================================================================ -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.15 -0.85</direction>
    </light>

    <!-- Ambient illumination for clear visibility from all angles -->
    <scene>
      <ambient>0.6 0.6 0.65 1.0</ambient>
      <background>0.8 0.85 0.9 1.0</background>
      <shadows>true</shadows>
    </scene>

    <!-- ================================================================ -->
    <!-- GROUND PLANE                                                      -->
    <!-- ================================================================ -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.75 0.75 0.75 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================ -->
    <!-- PERIMETER WALLS (10m x 10m enclosure)                             -->
    <!-- ================================================================ -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 5 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10.2 0.2 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10.2 0.2 1.2</size></box></geometry>
          <material>
            <ambient>0.25 0.35 0.50 1</ambient>
            <diffuse>0.35 0.45 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -5 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10.2 0.2 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10.2 0.2 1.2</size></box></geometry>
          <material>
            <ambient>0.25 0.35 0.50 1</ambient>
            <diffuse>0.35 0.45 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>5 0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 10.2 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 10.2 1.2</size></box></geometry>
          <material>
            <ambient>0.25 0.35 0.50 1</ambient>
            <diffuse>0.35 0.45 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-5 0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 10.2 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 10.2 1.2</size></box></geometry>
          <material>
            <ambient>0.25 0.35 0.50 1</ambient>
            <diffuse>0.35 0.45 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================ -->
    <!-- INTERIOR PARTITION WALLS (Rooms & Corridors for SLAM)            -->
    <!-- ================================================================ -->

    <!-- North-West Room Partition (with doorway to corridor) -->
    <model name="partition_nw">
      <static>true</static>
      <pose>-2.5 2.5 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 3.0 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 3.0 1.2</size></box></geometry>
          <material>
            <ambient>0.50 0.50 0.55 1</ambient>
            <diffuse>0.65 0.65 0.70 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- North-East Horizontal Wall -->
    <model name="partition_ne">
      <static>true</static>
      <pose>2.5 2.0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3.5 0.2 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.5 0.2 1.2</size></box></geometry>
          <material>
            <ambient>0.50 0.50 0.55 1</ambient>
            <diffuse>0.65 0.65 0.70 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- South-East L-Divider -->
    <model name="partition_se_vertical">
      <static>true</static>
      <pose>2.0 -2.5 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 3.5 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 3.5 1.2</size></box></geometry>
          <material>
            <ambient>0.50 0.50 0.55 1</ambient>
            <diffuse>0.65 0.65 0.70 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- South-West Wall -->
    <model name="partition_sw_horizontal">
      <static>true</static>
      <pose>-2.0 -2.0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3.0 0.2 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.0 0.2 1.2</size></box></geometry>
          <material>
            <ambient>0.50 0.50 0.55 1</ambient>
            <diffuse>0.65 0.65 0.70 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================ -->
    <!-- SLAM LANDMARKS & OBSTACLES                                       -->
    <!-- Cylinders (pillars) & boxes (crates/furniture)                   -->
    <!-- ================================================================ -->

    <!-- Pillar 1 (North-West) -->
    <model name="pillar_nw">
      <static>true</static>
      <pose>-1.2 3.2 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.25</radius><length>1.2</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>1.2</length></cylinder></geometry>
          <material>
            <ambient>0.80 0.35 0.15 1</ambient>
            <diffuse>0.90 0.45 0.20 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Pillar 2 (South-East) -->
    <model name="pillar_se">
      <static>true</static>
      <pose>3.5 -1.2 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.25</radius><length>1.2</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>1.2</length></cylinder></geometry>
          <material>
            <ambient>0.80 0.35 0.15 1</ambient>
            <diffuse>0.90 0.45 0.20 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Pillar 3 (South-West) -->
    <model name="pillar_sw">
      <static>true</static>
      <pose>-3.5 -3.5 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.30</radius><length>1.2</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.30</radius><length>1.2</length></cylinder></geometry>
          <material>
            <ambient>0.80 0.35 0.15 1</ambient>
            <diffuse>0.90 0.45 0.20 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Crate / Box 1 (North-East Room) -->
    <model name="crate_ne">
      <static>true</static>
      <pose>3.5 3.5 0.35 0 0 0.3</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.8 0.8 0.7</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.8 0.8 0.7</size></box></geometry>
          <material>
            <ambient>0.65 0.50 0.25 1</ambient>
            <diffuse>0.75 0.60 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Crate / Box 2 (West Room) -->
    <model name="crate_west">
      <static>true</static>
      <pose>-3.8 0.0 0.3 0 0 -0.2</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.9 0.6 0.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.9 0.6 0.6</size></box></geometry>
          <material>
            <ambient>0.20 0.60 0.35 1</ambient>
            <diffuse>0.30 0.70 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Crate / Box 3 (South Corridor) -->
    <model name="crate_south">
      <static>true</static>
      <pose>0.0 -3.8 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.8 0.5 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.8 0.5 0.5</size></box></geometry>
          <material>
            <ambient>0.70 0.25 0.25 1</ambient>
            <diffuse>0.80 0.35 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>

